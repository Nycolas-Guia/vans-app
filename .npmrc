# Metro (bundler do React Native/Expo) não resolve bem a estrutura padrão
# do pnpm (node_modules com symlinks/aninhamento estrito) — isso, e não a
# versão do Node/pnpm, é a causa do erro "Unable to resolve module
# ./node_modules/expo/AppEntry.js". node-linker=hoisted faz o pnpm montar
# um node_modules "achatado" (mais parecido com npm/yarn classic), que o
# Metro consegue atravessar. Ver: https://docs.expo.dev/guides/monorepos/
node-linker=hoisted
